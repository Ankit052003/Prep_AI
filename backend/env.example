PORT=5000
MONGO_URI=<mongodb-connection-string>
JWT_SECRET=<jwt-secret>
GROK_API_KEY=<groq-or-xai-compatible-api-key>

# Required for "Continue with Google".
# Use a Google Cloud OAuth 2.0 Web client ID, not an Android/iOS/Desktop client ID.
GOOGLE_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com

